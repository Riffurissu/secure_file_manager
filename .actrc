# Настройки локального раннера act (читаются автоматически из корня репозитория).
# Требуется свежая версия act; если флаг не поддерживается — обновите act или
# передайте его в командной строке (см. README, раздел «CI/CD»).

# Образ для джоб с runs-on: ubuntu-latest: Docker CLI, node, git, curl.
-P ubuntu-latest=catthehacker/ubuntu:act-latest

# Архитектура контейнеров джоб (нужна на ARM-хостах, на x64 безвредна).
--container-architecture linux/amd64

# Проброс Docker-сокета хоста в контейнеры джоб — нужен стадии local_deploy,
# где вызываются docker build и docker run.
--container-options "-v /var/run/docker.sock:/var/run/docker.sock"
